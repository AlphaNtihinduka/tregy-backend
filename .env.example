# Copy to .env (never commit .env). Safe placeholders only.

# --- Database. In Docker the host is "postgres", never localhost.
POSTGRES_DB=tregy
POSTGRES_USER=tregy
POSTGRES_PASSWORD=replace_with_a_strong_password

# --- CORS: web client origins, comma separated. Never "*".
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Added by later phases (kept here as a reminder, not used yet):
# JWT_SECRET=            phase 1; generate with: openssl rand -base64 48
# RESEND_API_KEY=        phase 1 (email verification / password reset)
