# Copy to .env (never commit .env). Safe placeholders only.

# --- Database. In Docker the host is "postgres", never localhost.
POSTGRES_DB=tregy
POSTGRES_USER=tregy
POSTGRES_PASSWORD=replace_with_a_strong_password

# --- CORS: web client origins, comma separated. Never "*".

# --- Accounts and sessions
# Generate with: openssl rand -base64 48   (at least 32 bytes; never reuse across environments)
JWT_SECRET=
# Base of the verification and reset links (the app deep link). Production must be https://
PUBLIC_APP_URL=tregy://
# Email provider (Resend). Leave empty locally: emails are then suppressed and only logged.
RESEND_API_KEY=
EMAIL_FROM=

# Added by later phases (kept here as a reminder, not used yet):
# ANTHROPIC_API_KEY=     only needed when a real model client exists (not yet); server-side only, never in the app
# GENERATION_PROVIDER=fake   the only provider implemented; MAX_ITEMS_PER_RUN, MONTHLY_GENERATION_BUDGET (USD) and
# GENERATION_MODEL_ID / GENERATION_INPUT_USD_PER_MTOK / GENERATION_OUTPUT_USD_PER_MTOK are optional
